<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="product_editable_tree_view">
            <field name="name">product.editable.tree.view</field>
            <field name="model">product.editable.list</field>
            <field name="arch" type="xml">
                <tree string="Product Editable List"
                      editable="top" create="1" edit="1">
                    <field name="name" required="1"/>
                    <field name="default_code" required="1"/>
                    <field name="l10n_in_hsn_code" required="1"/>
                    <field name="list_price" required="1"/>
                    <field name="categ_id" required="1"/>
                    <field name="brand" required="1"/>
                    <field name="product_commission" required="1"/>
                    <field name="product_color" required="1"/>
                    <field name="product_style" required="1"/>
                    <field name="pos_categ_id" required="1"/>
                    <field name="size_range" invisible="1"/>
                    <field name="size_from" required="1"/>
                    <field name="size_to" required="1"/>
                    <field name="vendor" required="1"/>
                    <field name="vendor_price" required="1"/>
                    <field name="public_categ_ids" widget="many2many_tags" force_save="1" required="1"/>
                    <field name="is_product" invisible="1"/>
                    <button name="create_product" string="Create Product" type="object" class="btn-success"
                         invisible="is_product == True"/>
                    <button name="show_product" string="Show Product" type="object" class="btn-primary"
                            invisible="is_product != True"/>
                </tree>
            </field>
        </record>

        <record id="product_editable_list_action" model="ir.actions.act_window">
            <field name="name">Product Editable</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.editable.list</field>
            <field name="view_mode">tree</field>
        </record>

        <menuitem id="product_editable_list_menu"
                  name="Product Editable List"
                  parent="sale.product_menu_catalog"
                  action="product_editable_list_action"/>

    </data>
</odoo>