<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_only_form_view_inherit" model="ir.ui.view">
            <field name="name">product.template.only.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_information']//field[@name='detailed_type']" position="after">
                    <field name="brand" invisible="1"/>
                </xpath>
                <xpath expr="//page[@name='general_information']//field[@name='barcode']" position="after">
                    <field name="company_reference"/>
                    <field name="size_range" invisible="1"/>
                    <field name="size_from"/>
                    <field name="size_to"/>
                </xpath>
            </field>
        </record>

        <record id="chakhdi_product_template_form_view" model="ir.ui.view">
            <field name="name">chakhdi.product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='image_1920']" position="attributes">
                    <attribute name="options">{'size': [180, 180]}</attribute>
                </xpath>
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="product_commission"/>
                    <field name="product_color"/>
                    <field name="product_style"/>
                    <field name="is_image_set" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='uom_po_id']" position="after">
                    <field name="promo_code"/>
                </xpath>
            </field>
        </record>

        <record id="chakhdi_product_product_form_view" model="ir.ui.view">
            <field name="name">chakhdi.product.product.form.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="company_reference"/>
                </xpath>
            </field>
        </record>

        <record id="pos_category_inherit_form_view" model="ir.ui.view">
            <field name="name">pos.category.form.inherit</field>
            <field name="model">pos.category</field>
            <field name="inherit_id" ref="point_of_sale.product_pos_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="artical_code" class="oe_inline"/>
                    <field name="is_not_for_published" class="oe_inline"/>
                </xpath>
            </field>
        </record>

        <record id="chakhdi_product_template_tree_view" model="ir.ui.view">
            <field name="name">chakhdi.product.template.tree.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="qty_available" position="move"/>
                </xpath>
            </field>
        </record>

        <record id="chakhdi_product_product_tree_view" model="ir.ui.view">
            <field name="name">chakhdi.product.product.tree.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="qty_available" position="move"/>
                </xpath>
                <xpath expr="//field[@name='is_published']" position="attributes">
                     <attribute name="optional">show</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
